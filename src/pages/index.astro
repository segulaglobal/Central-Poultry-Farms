---
import { Image } from 'astro:assets';
import LogoWhite from "../assets/logo-white.png"

import Welcome from '../components/Welcome.astro';
import MainLayout from '../layouts/MainLayout.astro';
import Wave from '../components/Wave.astro';


---

<MainLayout>
	<!-- <Welcome /> -->
	 <div class="coming-soon">
		<div class="container">
			<div class="coming-container">
				<Image src={LogoWhite} alt="Central Poutry Farm" />
				<h1>Coming soon</h1>
				<p>Our Engineers are working hard to get you an amazing experience.</p>
			</div>
		</div>
		<Wave />
	 </div>
</MainLayout>




<style lang="scss">

.coming-soon {
	width: 100%;
	height: 95vh;
	background: linear-gradient(to left bottom, rgba(236, 142, 34, 0.681), rgba(4, 13, 68, 0.929)), url(../assets/coming-soon-bg.png);
	background-size: cover;
	background-position: center;

	.coming-container {
		text-align: center;
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-direction: column;
		max-width: 600px;
		margin-inline: auto;
		color: #fff;
	}

	img {
		max-width: 200px;
	}

	h1 {
		font-size: 3rem;
		font-weight: bold;
	}
}

</style>