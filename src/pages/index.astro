---
import { Image } from 'astro:assets';
import LogoWhite from "../assets/logo-white.png"

import Welcome from '../components/Welcome.astro';
import MainLayout from '../layouts/MainLayout.astro';
import Wave from '../components/Wave.astro';
import NavBar from "../components/NavBar";
import Footer from "../components/Footer/Footer";

---

<MainLayout>
	<!-- Navigation Goes here -->
	<NavBar client:load/>

	<!-- <Welcome /> -->
	 <div class="coming-soon relative">
		<div class="container">
			<div class="coming-container">
				<Image src={LogoWhite} alt="Central Poultry Farm" />
				<h1>Coming soon</h1>
				<p>Our Engineers are working hard to get you an amazing experience.</p>
			</div>
		</div>
		<Wave />
	 </div>


	 <!-- ============ Footer goes here ========== -->
	<Footer />
</MainLayout>




<style lang="scss">

.coming-soon {
	width: 100%;
	height: 95vh;
	background: linear-gradient(to left bottom, rgba(236, 142, 34, 0.681), rgba(4, 13, 68, 0.929)), url(../assets/coming-soon-bg.png);
	background-size: cover;
	background-position: center;

	.coming-container {
		text-align: center;
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-direction: column;
		max-width: 600px;
		margin-inline: auto;
		color: #fff;
	}

	img {
		max-width: 250px;
		margin-bottom: 2rem;
	}

	h1 {
		font-size: 5rem;
		line-height: 1;
		font-weight: bolder;
		margin-bottom: 1rem;
	}
}

</style>