---
import { Image } from 'astro:assets';
import LogoWhite from "../assets/logo-white.png"
import LogoRound from "../assets/round-logo.png";

import Welcome from '../components/Welcome.astro';
import MainLayout from '../layouts/MainLayout.astro';
import WaveYellow from '../components/WaveYellow.astro';
import NavBar from "../components/NavBar/NavBar";
import About from "../components/About.astro"
import Footer from "../components/Footer/Footer";

---

<MainLayout>
	<!-- Navigation Goes here -->
	<NavBar client:load/>

	<!-- <Welcome /> -->
	 <div class="home-hero relative">
		<div class="container">
			<div class="hero-container text-center md:text-left">
				<h1 class="text-5xl font-black mb-4">Premium Organic Eggs at Industrial Scale</h1>
				<p class="mb-8 ">Our Engineers are working hard to get you an amazing experience.</p>
				<div>
					<a href="#" class="btn btn-blue">Request WholeSale Quote</a>
					<a href="#" class="btn-yellow-thin">Our Services</a>
				</div>
			</div>
		</div>
		<WaveYellow />
	 </div>



	 <!-- yellow Section -->
	<section class="section-yellow">
		<div class="container">
			<div class="flex items-center gap-12">
				<Image src={LogoRound} alt="Central Poultry Logo" />
				<div>
					<p class="font-black text-5xl leading-[1.5]">antibiotic-free poultry farming with advanced climate control technology</p>
				</div>
			</div>
		</div>
	</section>
	<!-- End of section yellow -->



	<!-- section About -->
	<About />

	 <!-- ============ Footer goes here ========== -->
	<Footer />
</MainLayout>










<style lang="scss">

.home-hero {
	width: 100%;
	height: 95vh;
	background: linear-gradient(to right top, rgb(4, 13, 68) 0%, rgb(4, 13, 68) 20%, rgba(232, 171, 38, 0.604)), url(../assets/coming-soon-bg.png);
	background-size: cover;
	background-position: center;

	.hero-container {
		width: 100%;
		height: 100%;
		display: flex;
		justify-content: center;
		flex-direction: column;
		color: #fff;
		max-width: 800px;
	}

}


.section-yellow {
	background-image: url(../assets/yellow-bg.png);
	padding: 4rem 0;
}

</style>